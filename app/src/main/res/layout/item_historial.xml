<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textCliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/fondo"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Juan Pérez" />

            <TextView
                android:id="@+id/textFolio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E67E22"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="482aB" />
        </LinearLayout>

        <TextView
            android:id="@+id/textContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/gris_texto"
            android:textSize="12sp"
            tools:text="📞 9511234567 | Laptop HP" />

        <TextView
            android:id="@+id/textServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gris_texto"
            android:textSize="12sp"
            tools:text="🛠️ Cambio de Pieza | ⚠️ No enciende" />

        <TextView
            android:id="@+id/textPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/fondo"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="💰 $800.00  |  Anticipo: $200.00" />

        <LinearLayout
            android:id="@+id/contenedorFotosMini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/textFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/gris_texto"
            android:textSize="11sp"
            tools:text="29/07/2026 10:32" />

        <TextView
            android:id="@+id/textEntregado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/acento"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="✅ Entregado: 30/07/2026" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVistaPrevia"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Vista previa"
                android:src="@android:drawable/ic_menu_view" />

            <ImageButton
                android:id="@+id/btnReimprimirFolio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reimprimir folio"
                android:src="@drawable/ic_label_tag" />

            <ImageButton
                android:id="@+id/btnReimprimir"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reimprimir ticket"
                android:src="@drawable/ic_print" />

            <ImageButton
                android:id="@+id/btnEliminar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar"
                android:src="@android:drawable/ic_menu_delete" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
